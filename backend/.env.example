# Azure AD app registration (Microsoft Entra ID) — voir README pour la procédure
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3001/auth/callback

# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modèles utilisés (voir README pour les compromis coût/qualité)
CLASSIFY_MODEL=claude-opus-5
DRAFT_MODEL=claude-opus-5

# Port du serveur backend
PORT=3001

# URL du frontend (pour CORS et redirection post-login)
FRONTEND_URL=http://localhost:5173
